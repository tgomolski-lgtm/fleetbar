DEFAULT_CONFIG_PATH = os.path.expanduser("~/.config/fleetbar/config.json")

CONFIG_DEFAULTS = {
    "fleetName": "Fleet",
    "dashboardUrl": "",
    "sshCommand": "ssh {name}",
    "tailscale": {},
    "victoriametrics": {},
    "checks": [],
    "history": {},
    "nodeInfo": {},
    "nodeStats": {},
